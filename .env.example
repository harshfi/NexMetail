# Public site URL (no trailing slash). Used for metadata, sitemap, canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.nexmetal.in

# Google Analytics 4 measurement ID (leave empty to disable analytics)
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (content of the meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# Resend — transactional email for the enquiry form
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=sales@nexmetal.in
ENQUIRY_FROM_EMAIL="NexMetal Website <enquiries@nexmetal.in>"
